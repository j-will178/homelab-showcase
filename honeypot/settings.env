# Honeypot settings read by cloud-ops/honeypot/hp-rebuild and passed to both Packer and Terraform.
# REGION must offer both droplet sizes (s-1vcpu-512mb-10gb, s-1vcpu-1gb). On 2026-11-18 that was
# blr1 fra1 lon1 sfo2 tor1 (not nyc*). A change here moves both droplets on the next rebuild.
REGION=tor1
