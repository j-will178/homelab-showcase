#!/usr/bin/python3
"""
hp-pull: brings the honeypot's Cowrie log to the dashboard. Runs on cloud-ops as hp-pull.service
(the unprivileged system user hp-pull, sandboxed by systemd).

Every 30 s:
  ssh hp-honeypot health                the honeypot's health snapshot (hp-health; full diagnostics
                                        only in mode lab-debug)
  ssh hp-honeypot read INODE OFFSET     through the bastion, with the lab key; on the honeypot this
                                        key can only run hp-log-read (sshd ForceCommand)
  POST /api/honeypot/ingest             the new log lines + this side's status and the health
                                        snapshot, agent token

The lines are attacker-controlled. This program never interprets them: it only splits the reader's
output into lines and forwards them; the dashboard parses them as hostile input.

The cursor (where the next read continues) is saved only after the dashboard accepted the whole
chunk, so nothing is lost if the dashboard is down; a batch sent twice (a retry after a partial
failure) has the same id and is ignored by the dashboard. A rebuilt
honeypot has a new host key, which starts a new cursor (its log starts empty).

    hp-pull                  the service loop
    hp-pull ssh ARGS...      as root, for testing: ssh with the same config and the lab key,
                             e.g.  sudo hp-pull ssh hp-honeypot read
"""

import hashlib
import json
import os
import subprocess
import sys
import time
import urllib.error
import urllib.request

LIB = "/var/lib/honeypot"
ENDPOINTS = f"{LIB}/endpoints.json"        # from hp-rebuild: addresses, pinned host keys, mode
REBUILD = f"{LIB}/status.json"             # from hp-rebuild: last result, image, times
DASHBOARD = "http://optiplex-management.home.arpa:8080/api/honeypot/ingest"
EVERY = 30
BATCH_BYTES = 1024 * 1024                  # per POST (the dashboard accepts up to 2 MB)
BATCH_LINES = 5000


def log(msg):
    print(msg, flush=True)


def read_json(path):
    try:
        with open(path) as f:
            return json.load(f)
    except (OSError, ValueError):
        return None


def write_json(path, data):
    tmp = path + ".tmp"
    with open(tmp, "w") as f:
        json.dump(data, f)
    os.replace(tmp, path)


def ssh_config(ep, key, known_hosts, path):
    """Config for the two hops. ProxyCommand (not ProxyJump) so the inner ssh gets the same -F."""
    with open(known_hosts, "w") as f:
        f.write(ep["known_hosts"])
    cfg = f"""# written by hp-pull from {ENDPOINTS}
Host *
    IdentityFile {key}
    IdentitiesOnly yes
    UserKnownHostsFile {known_hosts}
    GlobalKnownHostsFile /dev/null
    StrictHostKeyChecking yes
    CheckHostIP no
    BatchMode yes
    ConnectTimeout 15
    ServerAliveInterval 15
    ServerAliveCountMax 2
    LogLevel ERROR
Host hp-bastion
    HostName {ep["bastion"]}
    Port 2222
    User jump
    HostKeyAlias hp-bastion
Host hp-honeypot
    HostName {ep["honeypot"]}
    Port 47022
    User collector
    HostKeyAlias hp-honeypot
    ProxyCommand ssh -F {path} -W %h:%p hp-bastion
"""
    with open(path + ".tmp", "w") as f:
        f.write(cfg)
    os.replace(path + ".tmp", path)


def machine_id(ep):
    """Identifies one honeypot build: its pinned host key (new on every rebuild)."""
    line = next((l for l in ep["known_hosts"].splitlines() if l.startswith("hp-honeypot ")), "")
    return hashlib.sha256(line.encode()).hexdigest()[:16]


def read_log(cfg, inode, offset):
    args = ["read"] + ([str(inode), str(offset)] if inode is not None else [])
    p = subprocess.run(["ssh", "-F", cfg, "hp-honeypot", *args], capture_output=True, timeout=120)
    if p.returncode != 0:
        raise RuntimeError(f"ssh exit {p.returncode}: {p.stderr.decode('utf-8', 'replace').strip()[-200:]}")
    head, _, body = p.stdout.partition(b"\n")
    h = json.loads(head)
    if h.get("v") != 1:
        raise RuntimeError("unexpected reader version")
    return h, body


def batches(body):
    """Split a chunk (whole lines, possibly from more than one log file) into POST-sized lists.
    Deterministic: the same chunk always gives the same batches (their ids depend on it)."""
    out, cur, size = [], [], 0
    for raw in body.splitlines(keepends=True):
        if cur and (size + len(raw) > BATCH_BYTES or len(cur) >= BATCH_LINES):
            out.append(cur)
            cur, size = [], 0
        cur.append(raw.rstrip(b"\r\n").decode("utf-8", "replace"))
        size += len(raw)
    if cur:
        out.append(cur)
    return out


def batch_id(mid, cursor, i, lines):
    digest = hashlib.sha256("\n".join(lines).encode()).hexdigest()[:16]
    return f"{mid}:{cursor['inode']}:{cursor['offset']}:{i}:{digest}"


def post(token, payload):
    data = json.dumps(payload).encode()
    req = urllib.request.Request(DASHBOARD, data=data, method="POST",
                                 headers={"Authorization": f"Bearer {token}", "Content-Type": "application/json"})
    with urllib.request.urlopen(req, timeout=30) as r:
        return json.load(r)


def status(state, error=None, pulled_at=None, health=None):
    rb = read_json(REBUILD) or {}
    ep = read_json(ENDPOINTS) or {}
    return {"state": state, "error": error, "pulled_at": pulled_at, "mode": ep.get("mode"),
            "honeypot_image": rb.get("honeypot_image"), "last_rebuild_at": rb.get("last_rebuild_at"),
            "last_apply_at": rb.get("last_apply_at"), "rebuild_result": rb.get("result"),
            "rebuild_error": rb.get("error"), "rebuild_error_tail": rb.get("error_tail"),
            "running": rb.get("running"), "health": health}


def fetch_health(cfg):
    """The snapshot as the honeypot wrote it (attacker-influenced in places: forwarded, never
    interpreted here). None if it can't be read; that never fails the pull."""
    try:
        p = subprocess.run(["ssh", "-F", cfg, "hp-honeypot", "health"], capture_output=True, timeout=60)
        if p.returncode != 0 or len(p.stdout) > 256 * 1024:
            return None
        h = json.loads(p.stdout)
        return h if isinstance(h, dict) else None
    except (subprocess.TimeoutExpired, ValueError, OSError):
        return None


def cycle(state_dir, key, token, cursor, last_ok):
    """One pull. Returns (cursor, last_ok)."""
    ep = read_json(ENDPOINTS)
    if not ep:
        rb = read_json(REBUILD)
        waiting = "waiting-build" if rb and rb.get("result") not in (None, "waiting") else "waiting-secrets"
        post(token, {"status": status(waiting)})
        return cursor, last_ok
    cfg, kh = os.path.join(state_dir, "ssh_config"), os.path.join(state_dir, "known_hosts")
    ssh_config(ep, key, kh, cfg)
    mid = machine_id(ep)
    if cursor.get("machine") != mid:
        log(f"new honeypot build ({mid}): reading its log from the start")
        cursor = {"machine": mid, "inode": None, "offset": 0}
    health = fetch_health(cfg)
    try:
        while True:
            h, body = read_log(cfg, cursor["inode"], cursor["offset"])
            sent = 0
            for i, lines in enumerate(batches(body)):
                r = post(token, {"id": batch_id(mid, cursor, i, lines), "lines": lines,
                                 "status": status("ok", pulled_at=int(time.time()), health=health)})
                sent += r.get("accepted", 0)
            if h.get("inode") is not None:           # all of it accepted: continue after it next time
                cursor = {"machine": mid, "inode": h["inode"], "offset": h["offset"]}
                write_json(os.path.join(state_dir, "cursor.json"), cursor)
            if sent:
                log(f"forwarded {sent} events")
            if not h.get("more"):
                break
        last_ok = int(time.time())
        post(token, {"status": status("ok", pulled_at=last_ok, health=health)})
    except (RuntimeError, ValueError, KeyError, subprocess.TimeoutExpired) as e:
        log(f"pull failed: {e}")
        post(token, {"status": status("error", error=str(e)[:300], pulled_at=last_ok, health=health)})
    return cursor, last_ok


def main():
    if len(sys.argv) > 1 and sys.argv[1] == "ssh":
        ep = read_json(ENDPOINTS) or sys.exit("no endpoints yet: the honeypot hasn't been built")
        d = "/run/hp-pull-manual"
        os.makedirs(d, mode=0o700, exist_ok=True)
        ssh_config(ep, "/etc/honeypot/lab_ed25519", f"{d}/known_hosts", f"{d}/ssh_config")
        os.execvp("ssh", ["ssh", "-F", f"{d}/ssh_config", *sys.argv[2:]])

    creds = os.environ.get("CREDENTIALS_DIRECTORY") or sys.exit("run as hp-pull.service (needs its credentials)")
    state_dir = os.environ.get("STATE_DIRECTORY", "/var/lib/hp-pull").split(":")[0]
    key = os.path.join(creds, "lab_key")
    with open(os.path.join(creds, "agent_token")) as f:
        token = f.read().strip()
    cursor = read_json(os.path.join(state_dir, "cursor.json")) or {}
    last_ok = None
    log("hp-pull started")
    while True:
        t0 = time.time()
        try:
            cursor, last_ok = cycle(state_dir, key, token, cursor, last_ok)
        except (urllib.error.URLError, OSError, ValueError) as e:
            log(f"dashboard not reachable: {e}")      # cursor not advanced: retried next time
        time.sleep(max(1, EVERY - (time.time() - t0)))


if __name__ == "__main__":
    main()
