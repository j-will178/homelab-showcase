#!/bin/bash
# hp-secrets: one-time setup of the honeypot's secrets on cloud-ops. Run it yourself:
#     ssh -t cloud-ops sudo hp-secrets
# Asks for the DigitalOcean API token (checked against the API) and your admin public key
# (hpadmin on the droplets). Generates the lab key (cloud-ops -> bastion -> honeypot) and the
# bastion's host key. Nothing here goes to git. Run it again to replace the token or admin key.
set -euo pipefail
[[ $EUID -eq 0 ]] || { echo "run with sudo" >&2; exit 1; }
ETC=/etc/honeypot KEYS=/var/lib/honeypot/keys
install -d -m 0700 "$ETC" "$KEYS"

echo "DigitalOcean API token (custom scopes, see honeypot/README.md). Input is hidden."
read -rsp "Token: " token; echo
[[ "$token" =~ ^[A-Za-z0-9_]{20,200}$ ]] || { echo "that doesn't look like a DigitalOcean token" >&2; exit 1; }
status="$(printf 'header = "Authorization: Bearer %s"\n' "$token" \
  | curl -fsS --proto '=https' -K - https://api.digitalocean.com/v2/account \
  | python3 -c 'import json,sys; print(json.load(sys.stdin)["account"]["status"])')" \
  || { echo "DigitalOcean rejected the token" >&2; exit 1; }
[[ "$status" == active ]] || { echo "account status is '$status', not active" >&2; exit 1; }
umask 077
printf '%s\n' "$token" > "$ETC/do_token.new" && mv -f "$ETC/do_token.new" "$ETC/do_token"
unset token
echo "token OK (account active), saved"

echo
echo "Your admin public key for 'hpadmin' on the droplets: the line from hpadmin.pub."
read -rp "Public key: " admin
[[ "$admin" =~ ^ssh-ed25519\ [A-Za-z0-9+/]{68}(\ [[:graph:]]{1,64})?$ ]] || { echo "expected one ssh-ed25519 public key line" >&2; exit 1; }
printf '%s\n' "$admin" > "$ETC/admin.pub"
echo "admin key saved"

[[ -f "$ETC/lab_ed25519" ]] || ssh-keygen -q -t ed25519 -N "" -C "cloud-ops-honeypot-lab" -f "$ETC/lab_ed25519"
[[ -f "$KEYS/bastion_host" ]] || ssh-keygen -q -t ed25519 -N "" -C "hp-bastion" -f "$KEYS/bastion_host"
echo "lab key and bastion host key ready"

echo
read -rp "Build the honeypot now (DigitalOcean starts billing, about \$10/month)? [y/N] " go
if [[ "$go" =~ ^[Yy]$ ]]; then
  systemctl start --no-block hp-rebuild.service
  echo "started. Follow it with: journalctl -fu hp-rebuild   (10-15 minutes)"
else
  echo "not started. It runs on its weekly timer, or now with: sudo systemctl start hp-rebuild"
fi
